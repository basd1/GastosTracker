<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        La pantalla de bienvenida es la del sistema (API SplashScreen de Android 12+; minSdk 33).
        MainActivity la mantiene visible hasta leer el tema guardado.
    -->
    <style name="Theme.GastosTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/verde_marca</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>

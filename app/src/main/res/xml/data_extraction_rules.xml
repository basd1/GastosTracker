<?xml version="1.0" encoding="utf-8"?>
<!--
    Qué se guarda en la copia de seguridad de Google y qué se pasa al cambiar de móvil.
    Con minSdk 33 este es el único fichero que cuenta (fullBackupContent solo se usaba hasta Android 11).

    Se respaldan los datos del usuario y nada más:
    - database/: la base de datos Room (gastos_tracker.db y sus ficheros -wal/-shm, que van juntos).
    - preferencias.preferences_pb: ajustes (tema) y la marca de "datos ya migrados a Room".
      Tiene que ir con la base de datos: si se restaurase sola, la app daría la migración por hecha.
    - settings.preferences_pb (dos rutas): los datos en JSON de versiones antiguas. Se conservan porque,
      si su migración falló, son la única copia (la app los vuelve a intentar migrar al arrancar).
    - tickets/: las fotos de los tickets adjuntas a los gastos.
    Todo lo demás (cachés, ficheros temporales de DataStore...) queda fuera.
-->
<data-extraction-rules>
    <!-- Son datos financieros: solo se suben a la nube si la copia va cifrada en el dispositivo. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
        <include domain="file" path="preferencias.preferences_pb" />
        <include domain="file" path="settings.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="tickets/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="preferencias.preferences_pb" />
        <include domain="file" path="settings.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="tickets/" />
    </device-transfer>
</data-extraction-rules>
